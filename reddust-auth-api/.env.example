# RedDust Auth API — Local Configuration Template
# Safe to commit. Replace placeholders only in .env.local.

# PostgreSQL — Appendix I
RD_DB_HOST=127.0.0.1
RD_DB_PORT=5432
RD_DB_NAME=reddust_dev
RD_DB_USER=reddust_app
RD_DB_PASSWORD=<REPLACE_LOCALLY>

# Runtime environment — Appendix L
RD_RUNTIME_ENV=local

# Google OpenID Connect — Appendix J
RD_GOOGLE_ALLOWED_AUDIENCES=<REPLACE_WITH_APPROVED_GOOGLE_CLIENT_ID>

# RedDust JWT signing keys — Appendix K
RD_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
RD_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
RD_JWT_KID=local-rsa-1

# RedDust Additional JWT configuration: 
RD_JWT_ISSUER=reddust-auth-local
RD_JWT_AUDIENCE=reddust-api
RD_ACCESS_TOKEN_TTL_SECONDS=900
RD_REFRESH_TOKEN_TTL_DAYS=30
