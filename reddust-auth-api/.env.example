RD_DB_HOST=127.0.0.1
RD_DB_PORT=5432
RD_DB_NAME=reddust_dev
RD_DB_USER=reddust_app
RD_DB_PASSWORD="REPLACE_WITH_PRIVATE_LOCAL_SECRET"
GOOGLE_ALLOWED_CLIENT_IDS="REPLACE_WITH_APPROVED_GOOGLE_CLIENT_ID"
REDDUST_JWT_ISSUER=reddust-auth-local
REDDUST_JWT_AUDIENCE=reddust-api
REDDUST_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
REDDUST_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30