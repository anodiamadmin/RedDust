        <mxCell id="note_ws" parent="1" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;rounded=1;fontSize=10;whiteSpace=wrap;" value="&lt;b&gt;WS message protocol&lt;/b&gt;&lt;br/&gt;Client→Server: {type:&#39;audio&#39;, data:b64, session_id?}&lt;br/&gt;Client→Server: {type:&#39;interrupt&#39;}&lt;br/&gt;Server→Client: {type:&#39;chunk&#39;, text:&#39;...&#39;}&lt;br/&gt;Server→Client: {type:&#39;done&#39;}&lt;br/&gt;Server→Client: {type:&#39;interrupted&#39;}" vertex="1">
          <mxGeometry height="110" width="320" x="1070" y="130" as="geometry" />
        </mxCell>
        <mxCell id="note_bargein" parent="1" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;rounded=1;fontSize=10;whiteSpace=wrap;" value="&lt;b&gt;Barge-in flow&lt;/b&gt;&lt;br/&gt;1. VAD detects onset during TTS playback&lt;br/&gt;2. Speech.stop() cuts current audio&lt;br/&gt;3. {type:&#39;interrupt&#39;} sent over WS&lt;br/&gt;4. Backend abort_event.set() breaks Gemini loop&lt;br/&gt;5. Backend sends {type:&#39;interrupted&#39;}&lt;br/&gt;6. Client clears chunk queue, starts new recording" vertex="1">
          <mxGeometry height="110" width="320" x="1070" y="260" as="geometry" />
        </mxCell>
        <mxCell id="note_vad" parent="1" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=1;fontSize=10;whiteSpace=wrap;" value="&lt;b&gt;VAD thresholds&lt;/b&gt;&lt;br/&gt;Onset: RMS &gt; -40 dB for 300 ms&lt;br/&gt;Offset: RMS &lt; -40 dB for 600 ms&lt;br/&gt;Polling: every 100 ms via getStatusAsync&lt;br/&gt;Active in both idle AND speaking states" vertex="1">
          <mxGeometry height="90" width="320" x="1070" y="390" as="geometry" />
        </mxCell>
        <mxCell id="note_scope" parent="1" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;rounded=1;fontSize=10;whiteSpace=wrap;" value="&lt;b&gt;Out of scope (this diagram)&lt;/b&gt;&lt;br/&gt;• Gemini Live API&lt;br/&gt;• Cloud TTS (uses on-device expo-speech)&lt;br/&gt;• Persistent DB (session_store is in-memory)&lt;br/&gt;• Auth / push notifications&lt;br/&gt;• Word-level timestamps" vertex="1">
