<mxfile host="Electron">
  <diagram name="Voice WS Architecture" id="voice-ws-arch">
    <mxGraphModel dx="1808" dy="898" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════════════ LEGEND ═══════════════════ -->
        <mxCell id="leg_rn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="React Native (client)" vertex="1">
          <mxGeometry x="20" y="20" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_ws" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="FastAPI / WS layer" vertex="1">
          <mxGeometry x="190" y="20" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Gemini (LLM)" vertex="1">
          <mxGeometry x="350" y="20" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_interrupt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="Barge-in / interrupt path" vertex="1">
          <mxGeometry x="490" y="20" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_tts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="expo-speech (TTS)" vertex="1">
          <mxGeometry x="680" y="20" width="150" height="30" as="geometry" />
        </mxCell>

        <!-- ═══════════════════ TITLE ═══════════════════ -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=16;" value="RedDust — Voice WebSocket Architecture" vertex="1">
          <mxGeometry x="300" y="65" width="700" height="35" as="geometry" />
        </mxCell>

        <!-- ═══════════════════ CLIENT CONTAINER ═══════════════════ -->
        <mxCell id="client_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontSize=13;fontStyle=1;verticalAlign=top;" value="React Native Client" vertex="1">
          <mxGeometry x="20" y="110" width="320" height="1500" as="geometry" />
        </mxCell>

        <!-- VAD -->
        <mxCell id="vad" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;useVAD hook&lt;/b&gt;&lt;br/&gt;RMS energy polling (100ms)&lt;br/&gt;SPEECH_THRESHOLD = -40 dB&lt;br/&gt;300 ms onset / 600 ms offset" vertex="1">
          <mxGeometry x="40" y="140" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Audio Recorder -->
        <mxCell id="recorder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;useAudioRecorder hook&lt;/b&gt;&lt;br/&gt;expo-av Recording (M4A)&lt;br/&gt;→ base64 via expo-file-system&lt;br/&gt;max 30 s safety cap" vertex="1">
          <mxGeometry x="40" y="270" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- WS Hook -->
        <mxCell id="ws_hook" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;useVoiceSocket hook&lt;/b&gt;&lt;br/&gt;WebSocket to /api/ws/voice&lt;br/&gt;auto-reconnect (exp. backoff, 3×)&lt;br/&gt;sendAudio(b64) | sendInterrupt()" vertex="1">
          <mxGeometry x="40" y="400" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- VoiceScreen -->
        <mxCell id="voice_screen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;VoiceScreen&lt;/b&gt;&lt;br/&gt;idle | listening | speaking states&lt;br/&gt;pulse animation during listen&lt;br/&gt;transcription + chunk text display" vertex="1">
          <mxGeometry x="40" y="530" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Chunk Queue -->
        <mxCell id="chunk_queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Chunk playback queue&lt;/b&gt;&lt;br/&gt;array of pending sentence chunks&lt;br/&gt;drained via onDone callbacks" vertex="1">
          <mxGeometry x="40" y="660" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- expo-speech -->
        <mxCell id="expo_speech" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;expo-speech&lt;/b&gt;&lt;br/&gt;Speech.speak(chunk)&lt;br/&gt;onDone → dequeue next chunk&lt;br/&gt;Speech.stop() on barge-in" vertex="1">
          <mxGeometry x="40" y="780" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Barge-in decision -->
        <mxCell id="bargein_check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="VAD detects speech&lt;br/&gt;while speaking?" vertex="1">
          <mxGeometry x="80" y="920" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ═══════════════════ BACKEND CONTAINER ═══════════════════ -->
        <mxCell id="backend_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;fontSize=13;fontStyle=1;verticalAlign=top;" value="FastAPI Backend" vertex="1">
          <mxGeometry x="430" y="110" width="500" height="1150" as="geometry" />
        </mxCell>

        <!-- WS Endpoint -->
        <mxCell id="ws_endpoint" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;WS /api/ws/voice&lt;/b&gt;&lt;br/&gt;ConnectionManager&lt;br/&gt;accepts connections, routes messages&lt;br/&gt;by type: 'audio' | 'interrupt'" vertex="1">
          <mxGeometry x="450" y="140" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Abort Event -->
        <mxCell id="abort_event" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;asyncio.Event (abort)&lt;/b&gt;&lt;br/&gt;per-connection&lt;br/&gt;reset on new audio msg&lt;br/&gt;set() on interrupt msg" vertex="1">
          <mxGeometry x="600" y="270" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Audio decode -->
        <mxCell id="audio_decode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Decode base64 audio&lt;/b&gt;&lt;br/&gt;detect MIME type (M4A)&lt;br/&gt;spawn asyncio task" vertex="1">
          <mxGeometry x="450" y="390" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- Voice Service -->
        <mxCell id="voice_service" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;call_gemini_voice_stream()&lt;/b&gt;&lt;br/&gt;audio_bytes + mime_type&lt;br/&gt;+ session_id + abort_event&lt;br/&gt;loads history, builds inline_data part" vertex="1">
          <mxGeometry x="450" y="510" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Gemini stream -->
        <mxCell id="gemini" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Gemini generate_content_stream&lt;/b&gt;&lt;br/&gt;(free-tier, not Live API)&lt;br/&gt;client.aio.models.generate_content_stream&lt;br/&gt;returns async iterator of chunks" vertex="1">
          <mxGeometry x="700" y="510" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- Abort check -->
        <mxCell id="abort_check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="abort_event&lt;br/&gt;.is_set()?" vertex="1">
          <mxGeometry x="490" y="640" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- Sentence splitter -->
        <mxCell id="sentence_split" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Sentence boundary splitter&lt;/b&gt;&lt;br/&gt;buffer chunks&lt;br/&gt;split on '. ' '! ' '? '&lt;br/&gt;emit complete sentences" vertex="1">
          <mxGeometry x="450" y="770" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- WS send chunk -->
        <mxCell id="ws_send_chunk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;WS send&lt;/b&gt; {type: 'chunk', text: '...'}&lt;br/&gt;one message per sentence" vertex="1">
          <mxGeometry x="450" y="890" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- WS send done -->
        <mxCell id="ws_send_done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;WS send&lt;/b&gt; {type: 'done'}&lt;br/&gt;stream complete" vertex="1">
          <mxGeometry x="450" y="990" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- WS send interrupted -->
        <mxCell id="ws_send_interrupted" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;WS send&lt;/b&gt; {type: 'interrupted'}&lt;br/&gt;abort confirmed to client" vertex="1">
          <mxGeometry x="680" y="700" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- Session store -->
        <mxCell id="session_store" parent="1" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;session_store&lt;/b&gt;&lt;br/&gt;in-memory (Redis later)&lt;br/&gt;conversation history" vertex="1">
          <mxGeometry x="620" y="1070" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Save turn -->
        <mxCell id="save_turn_v" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Save turn to session_store&lt;/b&gt;&lt;br/&gt;transcription + assistant reply" vertex="1">
          <mxGeometry x="450" y="1090" width="155" height="60" as="geometry" />
        </mxCell>

        <!-- ═══════════════════ EDGES — HAPPY PATH ═══════════════════ -->

        <!-- VAD → recorder (speechEnd) -->
        <mxCell id="e_vad_rec" edge="1" parent="1" source="vad" target="recorder" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_vad_rec" parent="e_vad_rec" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="onSpeechEnd" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- recorder → ws_hook (sendAudio base64) -->
        <mxCell id="e_rec_ws" edge="1" parent="1" source="recorder" target="ws_hook" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_rec_ws" parent="e_rec_ws" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="sendAudio(base64)" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_hook → ws_endpoint (WS frame: audio) -->
        <mxCell id="e_ws_to_backend" edge="1" parent="1" source="ws_hook" target="ws_endpoint" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_ws_audio" parent="e_ws_to_backend" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="{type:'audio', data:b64}" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_endpoint → abort_event (reset) -->
        <mxCell id="e_wse_abort" edge="1" parent="1" source="ws_endpoint" target="abort_event" style="edgeStyle=orthogonalEdgeStyle;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_reset" parent="e_wse_abort" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="reset()" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_endpoint → audio_decode -->
        <mxCell id="e_wse_decode" edge="1" parent="1" source="ws_endpoint" target="audio_decode" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- audio_decode → voice_service -->
        <mxCell id="e_decode_svc" edge="1" parent="1" source="audio_decode" target="voice_service" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- voice_service → gemini -->
        <mxCell id="e_svc_gemini" edge="1" parent="1" source="voice_service" target="gemini" style="edgeStyle=orthogonalEdgeStyle;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_gemini" parent="e_svc_gemini" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="audio inline_data + history" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- gemini → abort_check (each chunk) -->
        <mxCell id="e_gemini_check" edge="1" parent="1" source="gemini" target="abort_check" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=1;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_each_chunk" parent="e_gemini_check" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="each chunk" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- abort_check NO → sentence_split -->
        <mxCell id="e_check_no" edge="1" parent="1" source="abort_check" target="sentence_split" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_no" parent="e_check_no" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="No" vertex="1" connectable="0">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- abort_check YES → ws_send_interrupted -->
        <mxCell id="e_check_yes" edge="1" parent="1" source="abort_check" target="ws_send_interrupted" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_yes" parent="e_check_yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="Yes → break" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- sentence_split → ws_send_chunk -->
        <mxCell id="e_split_chunk" edge="1" parent="1" source="sentence_split" target="ws_send_chunk" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_sent" parent="e_split_chunk" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="complete sentence" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_send_chunk → ws_hook (back to client) -->
        <mxCell id="e_chunk_to_client" edge="1" parent="1" source="ws_send_chunk" target="ws_hook" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_chunk_back" parent="e_chunk_to_client" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="{type:'chunk'}" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_send_done back to client -->
        <mxCell id="e_done_to_client" edge="1" parent="1" source="ws_send_done" target="ws_hook" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="1015" />
              <mxPoint x="420" y="435" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_done_back" parent="e_done_to_client" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="{type:'done'}" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- stream end → ws_send_done -->
        <mxCell id="e_split_done" edge="1" parent="1" source="sentence_split" target="ws_send_done" style="edgeStyle=orthogonalEdgeStyle;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_stream_end" parent="e_split_done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="stream end" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_hook → chunk_queue (incoming chunks) -->
        <mxCell id="e_ws_to_queue" edge="1" parent="1" source="ws_hook" target="chunk_queue" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_enqueue" parent="e_ws_to_queue" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="enqueue chunk" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- chunk_queue → expo_speech -->
        <mxCell id="e_queue_speech" edge="1" parent="1" source="chunk_queue" target="expo_speech" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_speak" parent="e_queue_speech" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="Speech.speak(chunk)" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- expo_speech onDone → chunk_queue (loop) -->
        <mxCell id="e_speech_loop" edge="1" parent="1" source="expo_speech" target="chunk_queue" style="edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="815" />
              <mxPoint x="380" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_ondone" parent="e_speech_loop" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="onDone → dequeue next" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- VAD monitors during playback → bargein_check -->
        <mxCell id="e_vad_bargein" edge="1" parent="1" source="vad" target="bargein_check" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="175" />
              <mxPoint x="30" y="955" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_vad_monitor" parent="e_vad_bargein" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="monitors during playback" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- expo_speech → bargein_check -->
        <mxCell id="e_speech_bi" edge="1" parent="1" source="expo_speech" target="bargein_check" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_isspeaking" parent="e_speech_bi" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="isSpeaking=true" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- bargein YES: Speech.stop + sendInterrupt + startRecording -->
        <mxCell id="bargein_action" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Barge-in action&lt;/b&gt;&lt;br/&gt;1. Speech.stop()&lt;br/&gt;2. sendInterrupt() over WS&lt;br/&gt;3. startRecording()" vertex="1">
          <mxGeometry x="60" y="1060" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_bi_yes" edge="1" parent="1" source="bargein_check" target="bargein_action" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_bi_yes" parent="e_bi_yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="Yes" vertex="1" connectable="0">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- bargein NO: nothing -->
        <mxCell id="lbl_bi_no" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" value="No → continue" vertex="1">
          <mxGeometry x="235" y="960" width="100" height="30" as="geometry" />
        </mxCell>

        <!-- bargein_action sendInterrupt → ws_hook -->
        <mxCell id="e_bi_interrupt" edge="1" parent="1" source="bargein_action" target="ws_hook" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_interrupt" parent="e_bi_interrupt" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="{type:'interrupt'}" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_endpoint → abort_event (set on interrupt) -->
        <mxCell id="e_interrupt_abort" edge="1" parent="1" source="ws_endpoint" target="abort_event" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_abort_set" parent="e_interrupt_abort" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="set() on interrupt" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_send_interrupted → ws_hook (back) -->
        <mxCell id="e_interrupted_client" edge="1" parent="1" source="ws_send_interrupted" target="ws_hook" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="725" />
              <mxPoint x="420" y="435" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_interrupted_back" parent="e_interrupted_client" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="{type:'interrupted'}" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- session store reads/writes -->
        <mxCell id="e_svc_read_history" edge="1" parent="1" source="voice_service" target="session_store" style="edgeStyle=orthogonalEdgeStyle;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_read_hist" parent="e_svc_read_history" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="read history" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="e_save_hist" edge="1" parent="1" source="save_turn_v" target="session_store" style="edgeStyle=orthogonalEdgeStyle;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_write_hist" parent="e_save_hist" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="write turn" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ws_send_done → save_turn -->
        <mxCell id="e_done_save" edge="1" parent="1" source="ws_send_done" target="save_turn_v" style="edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- bargein_action → recorder (restart) -->
        <mxCell id="e_bi_restart" edge="1" parent="1" source="bargein_action" target="recorder" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="1050" />
              <mxPoint x="30" y="1050" />
              <mxPoint x="30" y="305" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_restart_rec" parent="e_bi_restart" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" value="startRecording()" vertex="1" connectable="0">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ═══════════════════ ANNOTATIONS ═══════════════════ -->
        <mxCell id="note_ws" parent="1" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;rounded=1;fontSize=10;whiteSpace=wrap;" value="&lt;b&gt;WS message protocol&lt;/b&gt;&lt;br/&gt;Client→Server: {type:'audio', data:b64, session_id?}&lt;br/&gt;Client→Server: {type:'interrupt'}&lt;br/&gt;Server→Client: {type:'chunk', text:'...'}&lt;br/&gt;Server→Client: {type:'done'}&lt;br/&gt;Server→Client: {type:'interrupted'}" vertex="1">
          <mxGeometry x="970" y="140" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note_bargein" parent="1" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;rounded=1;fontSize=10;whiteSpace=wrap;" value="&lt;b&gt;Barge-in flow&lt;/b&gt;&lt;br/&gt;1. VAD detects onset during TTS playback&lt;br/&gt;2. Speech.stop() cuts current audio&lt;br/&gt;3. {type:'interrupt'} sent over WS&lt;br/&gt;4. Backend abort_event.set() breaks Gemini loop&lt;br/&gt;5. Backend sends {type:'interrupted'}&lt;br/&gt;6. Client clears chunk queue, starts new recording" vertex="1">
          <mxGeometry x="970" y="270" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note_vad" parent="1" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=1;fontSize=10;whiteSpace=wrap;" value="&lt;b&gt;VAD thresholds&lt;/b&gt;&lt;br/&gt;Onset: RMS &gt; -40 dB for 300 ms&lt;br/&gt;Offset: RMS &lt; -40 dB for 600 ms&lt;br/&gt;Polling: every 100 ms via getStatusAsync&lt;br/&gt;Active in both idle AND speaking states" vertex="1">
          <mxGeometry x="970" y="400" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note_scope" parent="1" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;rounded=1;fontSize=10;whiteSpace=wrap;" value="&lt;b&gt;Out of scope (this diagram)&lt;/b&gt;&lt;br/&gt;• Gemini Live API&lt;br/&gt;• Cloud TTS (uses on-device expo-speech)&lt;br/&gt;• Persistent DB (session_store is in-memory)&lt;br/&gt;• Auth / push notifications&lt;br/&gt;• Word-level timestamps" vertex="1">
          <mxGeometry x="970" y="510" width="320" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
