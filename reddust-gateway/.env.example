# TURN Server Configuration (This is for Metered OpenRelay users only)
TURN_SERVER_URL_1=stun:stun.relay.metered.ca:80
TURN_SERVER_URL_2=turn:global.relay.metered.ca:80
TURN_SERVER_URL_3=turn:global.relay.metered.ca:80?transport=tcp
TURN_SERVER_URL_4=turn:global.relay.metered.ca:443
TURN_SERVER_URL_5=turns:global.relay.metered.ca:443?transport=tcp
# Authentication credentials for the TURN server
TURN_USERNAME=your_username_here
TURN_CREDENTIAL=your_credential_here