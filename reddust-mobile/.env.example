# This is an example environment file for the Expo project.
# You can copy this file to .env.local and set your own values for the environment variables.
# to get the local IP address of your laptop, run `ipconfig` on Windows or `ifconfig` on Mac/Linux
# and look for the IPv4 address of your active network connection.
# If the laptop's Wi-Fi IPv4 address changes, update this value.

EXPO_PUBLIC_GATEWAY_URL=http://192.168.1.8:8000
# TURN Server Configuration (This is for Metered OpenRelay users only)
EXPO_PUBLIC_TURN_SERVER_URL_1=stun:stun.relay.metered.ca:80
EXPO_PUBLIC_TURN_SERVER_URL_2=turn:global.relay.metered.ca:80
EXPO_PUBLIC_TURN_SERVER_URL_3=turn:global.relay.metered.ca:80?transport=tcp
EXPO_PUBLIC_TURN_SERVER_URL_4=turn:global.relay.metered.ca:443
EXPO_PUBLIC_TURN_SERVER_URL_5=turns:global.relay.metered.ca:443?transport=tcp
# Authentication credentials for the TURN server
EXPO_PUBLIC_TURN_USERNAME=your_username_here
EXPO_PUBLIC_TURN_CREDENTIAL=your_credential_here